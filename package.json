{
  "name": "froggy-docs",
  "version": "1.2.0-beta.2",
  "description": "Language-agnostic API documentation, testing, and static deployment from source annotations.",
  "author": "Kaung Mrat Thu <kaungmratthu.dev@gmail.com>",
  "homepage": "https://github.com/Kaung-Myat/froggydocs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaung-Myat/froggydocs.git"
  },
  "license": "MIT",
  "keywords": [
    "api",
    "documentation",
    "openapi",
    "swagger",
    "auto-generate",
    "api-docs",
    "developer-tools",
    "dart",
    "static-site"
  ],
  "bin": {
    "froggy-docs": "package.js"
  },
  "files": [
    "package.js",
    "frontend/web/",
    "README.md",
    "CHANGELOG.md",
    "DEPLOYMENT.md",
    "RELEASE.md",
    "LICENSE",
    "froggy_docs.example.yaml"
  ],
  "scripts": {
    "test": "node --test test/npm_wrapper_test.js",
    "verify-version": "node scripts/verify-version.js",
    "prepack": "npm run verify-version && npm test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {}
}
